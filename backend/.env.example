# backend/.env.example
# 이 파일을 복사해서 backend/.env 로 만들고 값을 채워주세요.
# (.env 는 .gitignore에 이미 포함되어 있어서 git에는 올라가지 않습니다.)

PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=flea_market_db

# 아무 값이나 넣어도 되지만, 실제 배포 시에는 반드시 바꿔주세요.
JWT_SECRET=flea-market-dev-secret-change-me

# [추가] 업로드 파일 저장 위치.
#   비워 두면 Z:/ 를 쓰고, Z: 드라이브가 없으면 backend/uploads/ 로 자동 대체됩니다.
#   팀 공유 드라이브를 쓰는 사람만 아래 줄의 주석을 풀어주세요.
# UPLOAD_ROOT=Z:/
