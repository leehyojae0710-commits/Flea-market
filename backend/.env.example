# backend/.env.example
#
# 이 파일을 복사해서 backend/.env 로 만들고 값을 채우세요.
#
#   Windows : copy .env.example .env
#   macOS   : cp .env.example .env
#
# .env 는 절대 git 에 올리지 마세요. (.gitignore 로 막아 뒀습니다)
# 이 예시 파일에는 실제 값을 적지 마세요. 예시 파일은 git 에 올라갑니다.

PORT=5000

# ── 데이터베이스 ──────────────────────────────────────────
# 팀 공용 DB 를 쓸 때는 DB_HOST 를 사내 서버 주소로 바꾸세요.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=flea_market_db

# ── 로그인 토큰 서명 키 ───────────────────────────────────
# [중요] 이 값을 아는 사람은 아무 계정의 로그인 토큰이나 만들어 낼 수 있습니다.
#        예시 값을 그대로 쓰지 말고, 아래 명령으로 만든 값을 넣으세요.
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# 값을 바꾸면 기존 로그인은 전부 풀립니다. (다시 로그인하면 됩니다)
JWT_SECRET=

# 토큰 유효기간 (선택). 비워 두면 액세스 2h / 리프레시 14일이 기본값입니다.
# ACCESS_TOKEN_TTL=2h
# REFRESH_TOKEN_TTL_DAYS=14

# ── 결제(PortOne) ─────────────────────────────────────────
# PortOne 콘솔에서 발급받은 API Secret 입니다. 비워 두면 결제 승인/취소가 실패합니다.
PORTONE_API_SECRET=

# ── CORS 허용 출처 ────────────────────────────────────────
# 비워 두면 모든 출처를 허용합니다. (개발 중에는 이대로 두어도 됩니다)
# 배포 전에는 실제 프론트 주소만 쉼표로 나열하세요.
# CORS_ORIGINS=http://localhost:5500,http://192.168.0.229:5500

# ── 업로드 파일 저장 위치 ─────────────────────────────────
# 비워 두면 Z:/ 를 쓰고, Z: 드라이브가 없으면 backend/uploads/ 로 자동 대체됩니다.
# 팀 공유 드라이브를 쓰는 사람만 아래 줄의 주석을 풀어주세요.
# UPLOAD_ROOT=Z:/

# ── 실행 환경 ─────────────────────────────────────────────
# production 으로 두면 JWT_SECRET·CORS_ORIGINS 가 없을 때 서버가 시작되지 않습니다.
# NODE_ENV=production
